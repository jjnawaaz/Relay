{
  "name": "websockets_4",
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:init": "bun run --filter database db:init",
    "db:update": "bun run --filter database db:update",
    "seed": "bun run --filter database db:seed"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
